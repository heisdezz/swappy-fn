            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"accept\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/swap/{{offerId}}/respond",
              "host": ["{{baseUrl}}"],
              "path": ["api", "swap", "{{offerId}}", "respond"]
            }
          }
        },
        {
          "name": "List User Swap Offers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
