            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/initialize",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "initialize"]
            }
          }
        },
        {
          "name": "Initialize Promoted Ad Payment (Top Search 7D)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"promotion\",\n  \"itemId\": \"{{itemId}}\",\n  \"tier\": \"top_search_7d\",\n  \"callbackUrl\": \"http://localhost:3000/payment/callback\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/initialize",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "initialize"]
            }
          }
        },
        {
          "name": "Verify Paystack Transaction (Callback Handshake)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"{{paystackRef}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "verify"]
            }
          }
        },
        {
          "name": "Paystack Webhook Listener",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-paystack-signature",
                "value": "HMAC_SHA512_SIGNATURE"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"charge.success\",\n  \"data\": {\n    \"reference\": \"swp_sub_1700000000\",\n    \"status\": \"success\",\n    \"amount\": 1000000,\n    \"currency\": \"NGN\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "webhook"]
