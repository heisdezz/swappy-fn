            "url": {
              "raw": "{{baseUrl}}/api/collections/swap_offers/records?expand=target_item,seller,proposer",
              "host": ["{{baseUrl}}"],
              "path": ["api", "collections", "swap_offers", "records"],
              "query": [
                {
                  "key": "expand",
                  "value": "target_item,seller,proposer"
                }
              ]
            }
          }
        }
