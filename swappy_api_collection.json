            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetItemId\": \"{{itemId}}\",\n  \"offeredModel\": \"iPhone 13 Pro\",\n  \"offeredStorage\": \"128GB\",\n  \"offeredColor\": \"Sierra Blue\",\n  \"offeredBattery\": 86,\n  \"offeredCondition\": \"good\",\n  \"offeredIssues\": \"Tiny hairline scratch on bezel, all components genuine\",\n  \"cashAdjustment\": 350000,\n  \"message\": \"Ready for meetup at Computer Village or Ikeja Mall to verify both phones.\"\n}"
            },
