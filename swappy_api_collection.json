      "name": "08. Payments & Paystack (NGN)",
      "item": [
        {
          "name": "Initialize Subscription Payment (Pro Seller)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
