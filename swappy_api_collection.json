    {
      "name": "03. Smartphone Listings",
      "item": [
        {
          "name": "Browse Catalog (Filtered Feed)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/collections/items/records?filter=(status='active')&sort=-is_promoted,-created&expand=seller,store&page=1&perPage=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "collections", "items", "records"],
              "query": [
                {
                  "key": "filter",
                  "value": "(status='active')"
                },
                {
                  "key": "sort",
                  "value": "-is_promoted,-created"
                },
                {
                  "key": "expand",
                  "value": "seller,store"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "perPage",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Get Single Item Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/collections/items/records/{{itemId}}?expand=seller,store",
              "host": ["{{baseUrl}}"],
              "path": ["api", "collections", "items", "records", "{{itemId}}"],
              "query": [
                {
                  "key": "expand",
                  "value": "seller,store"
                }
              ]
            }
          }
        },
        {
          "name": "Get Single Item by Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/collections/items/records?filter=(slug='{{itemSlug}}')&expand=seller,store",
              "host": ["{{baseUrl}}"],
              "path": ["api", "collections", "items", "records"],
              "query": [
                {
                  "key": "filter",
                  "value": "(slug='{{itemSlug}}')"
                },
                {
                  "key": "expand",
                  "value": "seller,store"
                }
              ]
            }
          }
        },
        {
          "name": "Create Smartphone Listing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seller\": \"YOUR_USER_ID\",\n  \"title\": \"iPhone 15 Pro 256GB Natural Titanium (Clean)\",\n  \"brand\": \"Apple\",\n  \"model\": \"iPhone 15 Pro\",\n  \"storage\": \"256GB\",\n  \"color\": \"Natural Titanium\",\n  \"battery_health\": 96,\n  \"condition\": \"flawless\",\n  \"carrier_status\": \"factory_unlocked\",\n  \"sim_type\": \"physical_sim_plus_esim\",\n  \"has_face_id\": true,\n  \"has_truetone\": true,\n  \"price\": 1250000,\n  \"accepts_swap\": true,\n  \"swap_preferences\": \"Willing to swap with iPhone 13 Pro or 14 Pro plus cash adjustment\",\n  \"location_state\": \"Lagos\",\n  \"location_city\": \"Ikeja\",\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/collections/items/records",
              "host": ["{{baseUrl}}"],
              "path": ["api", "collections", "items", "records"]
            }
          }
        },
        {
          "name": "Increment Item Views Count",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/items/{{itemId}}/view",
              "host": ["{{baseUrl}}"],
              "path": ["api", "items", "{{itemId}}", "view"]
